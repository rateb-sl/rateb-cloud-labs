{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ScopeSessionToThisLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:<region>:<account-id>:log-group:<log-group-name>:*"
    }
  ]
}
